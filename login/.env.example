; Copia este archivo como .env y escribe los datos de tu servidor.
; Usa comillas dobles cuando un valor contenga espacios o símbolos.
; Nombre mostrado en el título de las páginas y en el pie del dashboard.
APP_NAME="Aula Acceso"
; Dirección de la máquina donde se ejecuta MariaDB/MySQL; 127.0.0.1 es este equipo.
DB_HOST="127.0.0.1"
; Puerto TCP del servicio. Debe coincidir con el configurado en XAMPP.
DB_PORT="3306"
; Nombre de la base creada al importar database/instalar.sql.
DB_DATABASE="login_mvc"
; Usuario con permiso para consultar e insertar en la tabla usuarios.
DB_USERNAME="root"
; Contraseña del usuario de la BASE, no la contraseña de una cuenta del formulario.
; Este valor vacío es un ejemplo local; sustituirlo por el valor real en .env.
DB_PASSWORD=""
